{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2022", "DOM"],
    "types": ["vite/client"]
  },
  "include": ["src/env.d.ts", "src/api/employeeCenter.ts", "src/api/permissionManagement.ts", "src/pages/employee_center/**/*.ts", "src/pages/employee_center/**/*.vue", "src/pages/permission_management/**/*.ts", "src/pages/permission_management/**/*.vue", "src/pages/role_assignment/**/*.ts", "src/pages/role_assignment/**/*.vue"]
}
