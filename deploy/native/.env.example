# ========== 安装目录（勿放系统盘 /，建议挂到 /data 等大容量分区）==========
INSTALL_BASE=/data/yiran
BENCH_DIR=/data/yiran/frappe-bench

# ========== 源码分支 ==========
FRAPPE_BRANCH=develop
ERPNEXT_BRANCH=develop

# ========== PostgreSQL 服务器（正式库 + 测试库共用）==========
# 两个 Frappe 站点会在同一 PG 实例上各建一个独立 database
DB_HOST=192.168.1.114
DB_PORT=15432
DB_ROOT_USERNAME=postgres
DB_PASSWORD="your_password_here"

# ========== Redis ==========
# 无密码：redis://127.0.0.1:6379/1
# 有密码：redis://:你的密码@127.0.0.1:6379/1
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_PASSWORD=

# ========== 正式环境（PostgreSQL 库: yiran_customs）==========
PROD_SITE=hrms.localhost
PROD_DB_NAME=yiran_customs
PROD_ADMIN_PASSWORD=admin
PROD_HOST_NAME=http://192.168.1.114:8000

# ========== 测试环境（PostgreSQL 库: yiran_customs_test）==========
TEST_SITE=hrms-test.localhost
TEST_DB_NAME=yiran_customs_test
TEST_ADMIN_PASSWORD=admin
TEST_HOST_NAME=http://192.168.1.114:8001
CREATE_TEST_SITE=true

# ========== PostgreSQL 库间同步 ==========
# pg     = pg_dump/pg_restore 直同步（推荐，测试PG库→正式PG库）
# bench  = bench backup/restore 同步
SYNC_MODE=pg
SYNC_INCLUDE_FILES=true
BACKUP_INCOMING=/data/yiran/backups/incoming

# ========== 其他 ==========
LANGUAGE=zh

# 说明：
# 1. 正式库、测试库都是 PostgreSQL，在同一 DB_HOST:DB_PORT 上各有一个独立 database
# 2. 查看库名映射: bash deploy/native/show-pg-status.sh
# 3. 测试→正式:   bash deploy/native/sync-test-to-prod.sh
# 4. 正式→测试:   bash deploy/native/sync-prod-to-test.sh
# 5. 同步会覆盖目标库全部数据，执行前请确认
