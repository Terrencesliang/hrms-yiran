# ========== 基础设施模式 ==========
# false = 使用外部服务（远端/宿主机已有 PostgreSQL、Redis）
# true  = 使用 Docker 内置容器
USE_BUNDLED_POSTGRES=false
USE_BUNDLED_REDIS=false

# ---------- 外部 PostgreSQL ----------
# Docker 与 PG 在同一台 Windows 上时，必须用 host.docker.internal（不能用 192.168.1.114 / 127.0.0.1）
# PG 在另一台局域网机器上时，才写那台机器的 IP，如 192.168.1.114
DB_HOST=host.docker.internal
DB_PORT=15432
DB_ROOT_USERNAME=postgres
# 密码含 # 等特殊字符时请加双引号
DB_PASSWORD="your_password_here"

# ---------- 外部 Redis ----------
# 容器内访问宿主机 Redis 必须用 host.docker.internal
REDIS_URL=redis://host.docker.internal:6379/1

# 内置服务时（USE_BUNDLED_*=true）可改用：
# DB_HOST=postgres
# DB_PORT=5432
# REDIS_URL=redis://redis:6379
# Windows 本机 Redis：REDIS_URL=redis://host.docker.internal:6379/1

# ---------- 应用配置 ----------
ADMIN_PASSWORD=admin
SITE_NAME=hrms.localhost
# 可选：指定 PostgreSQL 库名（留空则由 Frappe 自动生成）
SITE_DB_NAME=yiran_customs
HTTP_PORT=8080
SOCKETIO_PORT=9000
FRAPPE_BRANCH=develop
ERPNEXT_BRANCH=develop
LANGUAGE=zh

# ---------- 本机数据同步 ----------
# true = 部署时自动导入 deploy/data/incoming 中的 bench 备份
SYNC_LOCAL_DATA=false
# 本机 WSL 导出源站点（export_local_data 使用）
LOCAL_SITE=hrms-test.localhost
LOCAL_WSL_DISTRO=hrms-dev
LOCAL_WSL_BENCH=/home/dev/frappe-bench

# 说明：
# 1. Frappe 会在 PostgreSQL 上自动新建独立数据库，不会占用 liangce / lake
# 2. postgres 账号需具备建库建用户权限
# 3. Redis 的 REDIS_ALLOW_INMEMORY 等变量为其他框架配置，Frappe 不使用
# 4. 远端部署时 Docker 仅运行 backend 容器，DB/Redis 走外部地址
# 5. install.ps1 会先导出本机 WSL 数据，再部署并自动恢复
# 6. 已部署后可运行 deploy/sync-data.ps1 重新同步
# 7. 切换模式后建议 docker compose down -v 再重装
