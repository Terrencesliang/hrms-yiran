# PostgreSQL 超级用户密码
DB_PASSWORD=hrms_db_root_2026

# PostgreSQL 超级用户名（一般无需修改）
DB_ROOT_USERNAME=postgres

# 数据库端口（容器内）
DB_PORT=5432

# Frappe 管理员（Administrator）登录密码
ADMIN_PASSWORD=admin

# 站点名称（首次安装后不建议修改）
SITE_NAME=hrms.localhost

# 对外访问端口（浏览器打开 http://localhost:8080）
HTTP_PORT=8080

# Socket.IO 端口（一般无需修改）
SOCKETIO_PORT=9000

# Frappe / ERPNext 分支（与当前定制版 develop 对齐）
FRAPPE_BRANCH=develop
ERPNEXT_BRANCH=develop

# 界面语言：zh / en
LANGUAGE=zh

# 若曾用 MariaDB 版部署过，需先执行 docker compose down -v 清空旧数据卷后再安装
